# ============================================================================
# Copy this file to .env (root) for the database/migration scripts, and to
# apps/backend/.env + apps/admin/.env for the apps themselves. Never commit
# the real .env files. See README.md for full setup instructions.
# ============================================================================

# ---- Database ---------------------------------------------------------------
# Local dev (docker-compose): matches docker-compose.yml postgres service.
# Production (Supabase): use the "Connection string" from
# Supabase Project Settings -> Database -> Connection string (URI, use the
# "Transaction pooler" string for serverless/Workers, "Session" for a
# long-running Node server).
DATABASE_URL=postgresql://textile:textile@localhost:55432/textile_admin

# ---- Backend server ----------------------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5190

# ---- Auth (Supabase Auth) ----------------------------------------------------
# Local dev: any random string works; `npm run dev-token` signs a working
# JWT with this same secret so protected routes are testable immediately.
# Production: Supabase Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=dev-local-jwt-secret-change-me
# Only needed once you connect a real Supabase project (server-side only,
# used for admin-level operations like provisioning auth users - never sent
# to the frontend).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (Cloudflare R2 / S3-compatible) --------------------------
# Local dev (docker-compose MinIO): values below match docker-compose.yml.
# Production (Cloudflare R2): create an R2 bucket + API token in the
# Cloudflare dashboard (R2 -> Manage R2 API Tokens) and fill these in -
# no code changes needed, the storage service speaks plain S3 API either way.
R2_ENDPOINT=http://localhost:59000
R2_REGION=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=textile-minio
R2_SECRET_ACCESS_KEY=textile-minio-secret
R2_BUCKET_NAME=product-images
# Public base URL images are served from. Local dev: MinIO's public endpoint.
# Production: your R2 bucket's public URL (custom domain or r2.dev subdomain).
R2_PUBLIC_URL=http://localhost:59000/product-images

# ============================================================================
# Frontend (apps/admin/.env) - only VITE_-prefixed vars are exposed to the
# browser bundle. Never put service-role keys or R2 secret keys here.
# ============================================================================
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
